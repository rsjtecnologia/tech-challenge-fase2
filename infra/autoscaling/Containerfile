FROM docker.io/library/python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    APP_PROFILE=diagnostics \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1
WORKDIR /app

COPY requirements.txt .
RUN python -m pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY scripts/load_autoscaling.py ./scripts/load_autoscaling.py
COPY infra/autoscaling/logging.json ./logging.json
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "src.web.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--log-config", "logging.json"]
